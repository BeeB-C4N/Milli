<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>こまつDMO 観光マーケティング戦略レポート（福岡県市場）</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#4FD1C5',
                        'primary-dark': '#38B2AC',
                        secondary: '#1A759F',
                        accent: '#E85D04',
                        light: '#F8F9FA',
                    },
                    fontFamily: {
                        sans: ['"Noto Sans JP"', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;800&display=swap" rel="stylesheet">
    
    <!-- React & Babel & Recharts -->
    <script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <script src="https://unpkg.com/prop-types/prop-types.min.js"></script>
    <script src="https://unpkg.com/recharts@2.1.9/umd/Recharts.js"></script>

    <style>
        /* 指定されたトンマナ */
        :root {
            --tifo-bg: #F7FAFC;
            --tifo-text: #2D3748;
            --tifo-primary: #4FD1C5;
            --tifo-primary-dark: #38B2AC;
            --tifo-card-border: #E2E8F0;
            --tifo-card-bg: #FFFFFF;
        }
        body {
            font-family: 'Noto Sans JP', sans-serif;
            background-color: var(--tifo-bg);
            color: var(--tifo-text);
        }
        
        /* 印刷用スタイリング */
        @media print {
            body { background-color: white !important; }
            .no-print { display: none !important; }
            .print-break-inside-avoid { page-break-inside: avoid; }
            .print-page-break { page-break-before: always; }
            .shadow-md, .shadow-sm, .shadow-lg, .tifo-card { box-shadow: none !important; border: 1px solid #e2e8f0; }
            * { -webkit-print-color-adjust: exact !important; color-adjust: exact !important; }
            .print-w-full { width: 100% !important; max-width: 100% !important; }
        }

        /* 共通コンポーネントスタイル */
        .tifo-card {
            background-color: var(--tifo-card-bg);
            border-radius: 1.5rem;
            padding: 1.5rem;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
            border: 1px solid var(--tifo-card-border);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        .tifo-button {
            background-color: var(--tifo-primary);
            color: white;
            font-weight: bold;
            padding: 0.75rem 1.5rem;
            border-radius: 9999px;
            border-bottom: 4px solid var(--tifo-primary-dark);
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }
        .tifo-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 12px -3px rgba(79, 209, 197, 0.4);
        }
        .tifo-button:active {
            transform: translateY(2px);
            border-bottom-width: 2px;
        }

        /* モーダル・スクロールバー・タブ */
        .feedback-tab-button {
            padding: 0.5rem 0.75rem;
            border-bottom: 3px solid transparent;
            font-weight: 600;
            color: #A0AEC0;
            transition: all 0.2s ease;
            flex-shrink: 0;
        }
        .feedback-tab-button:hover {
            background-color: #F7FAFC;
            color: #4A5568;
        }
        .feedback-tab-button.active {
            color: var(--tifo-primary);
            border-bottom-color: var(--tifo-primary);
        }
        
        /* 自由記述テーブル用のスクロールエリア */
        .table-scroll-container {
            max-height: 600px;
            overflow-y: auto;
        }
        .custom-scrollbar::-webkit-scrollbar { width: 8px; height: 8px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: #f1f1f1; border-radius: 10px; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        
        /* グラフ用ツールチップカスタム */
        .custom-tooltip {
            background: white;
            border: 1px solid #E2E8F0;
            padding: 10px;
            border-radius: 8px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            font-size: 0.875rem;
        }
    </style>
</head>
<body>
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect } = React;
        const { PieChart, Pie, Cell, BarChart, Bar, XAxis, YAxis, CartesianGrid, Tooltip, Legend, ResponsiveContainer, RadarChart, PolarGrid, PolarAngleAxis, PolarRadiusAxis, Radar } = window.Recharts;

        // --- アイコン群 ---
        const IconPlane = () => <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.2-1.1.6L3 8l6 5.8L6.5 16l-3.2-.8c-.4-.1-.8.2-1 .6L2 17l4 3 3 4 .8-1.5c.3-.5 0-1-.6-1L7.4 18l2.2-2.5 5.8 6c.3.3.7.4 1.2.1l1.2-1.2c.4-.3.6-.8.5-1.3Z"/></svg>;
        const IconUsers = () => <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>;
        const IconTarget = () => <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>;
        const IconMessage = () => <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>;
        const IconPrinter = () => <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect width="12" height="8" x="6" y="14"/></svg>;
        const IconBarChart = () => <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>;
        const IconSmartphone = () => <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>;

        // --- データセット (CSVの傾向から生成した拡張モックデータ) ---
        const surveyData = {
            overview: {
                totalRespondents: 142,
                avgNps: 6.8,
            },
            // グラフ用データ
            charts: {
                companion: [
                    { name: '家族連れ', value: 45 },
                    { name: '夫婦・パートナー', value: 25 },
                    { name: '友人同士', value: 15 },
                    { name: '一人', value: 10 },
                    { name: 'その他', value: 5 },
                ],
                npsDistribution: [
                    { score: '0-4', count: 12, fill: '#E2E8F0' },
                    { score: '5-6', count: 25, fill: '#CBD5E1' },
                    { score: '7-8', count: 65, fill: '#38B2AC' },
                    { score: '9-10', count: 40, fill: '#4FD1C5' },
                ],
                source: [
                    { name: 'Instagram', value: 58 },
                    { name: 'Web検索', value: 42 },
                    { name: '旅行サイト', value: 30 },
                    { name: '友人・知人', value: 18 },
                    { name: '旅行情報誌', value: 12 },
                ],
                consumption: [
                    { range: '1000円未満', count: 35 },
                    { range: '1k-3k円', count: 45 },
                    { range: '3k-5k円', count: 30 },
                    { range: '5k-10k円', count: 20 },
                    { range: '10k円以上', count: 12 },
                ],
            },
            // 自由記述生データ (20件)
            feedbacks: [
                { id: 1, type: "家族連れ", purpose: "航空プラザ・恐竜博物館", nps: 10, satisfaction: "とても満足", source: "Instagram", comment: "あたたかいスタッフの声かけ。無料と思えないほどの展示、遊び場。航空好きの我が家は終始大興奮でした。", improvement: "周辺でランチできる場所がパッと見分からなかった。結局福井まで我慢した。" },
                { id: 2, type: "夫婦", purpose: "通過・経由", nps: 6, satisfaction: "満足", source: "Web検索", comment: "小松空港を利用し、レンタカーを借りてそのまま金沢へ向かった。空港はコンパクトで使いやすかった。", improvement: "空港周辺で時間が潰せるおしゃれなカフェなどがもっとあれば寄ったかもしれない。" },
                { id: 3, type: "友人同士", purpose: "ひゃくまんさんグッズ", nps: 7, satisfaction: "満足", source: "友人・知人", comment: "小松駅周辺で探していたグッズが買えました。駅前も綺麗でした。", improvement: "駅周辺の観光スポットの情報が少なく、買い物が終わってすぐに移動してしまった。" },
                { id: 4, type: "シニア夫婦", purpose: "温泉・九谷焼", nps: 9, satisfaction: "とても満足", source: "旅行情報誌", comment: "粟津温泉の泉質が素晴らしく、セラミックラボでの九谷焼体験も見応えがありました。", improvement: "各施設間の移動手段（バス）の本数が少なく、車でないと不便だと感じた。" },
                { id: 5, type: "家族連れ", purpose: "自動車博物館", nps: 8, satisfaction: "満足", source: "Web検索", comment: "加賀から金沢への道中で寄りました。自動車博物館はレトロで子供より親が楽しめました。", improvement: "県を跨いでの観光ルートのアドバイスやマップがあれば嬉しい。" },
                { id: 6, type: "一人", purpose: "ビジネス・出張", nps: 5, satisfaction: "普通", source: "旅行サイト", comment: "仕事で小松駅前のホテルを利用。飲食店はそこそこあって困らなかった。", improvement: "夜遅くまでやっているお店や、一人で入りやすい郷土料理の店が分かりにくかった。" },
                { id: 7, type: "家族連れ", purpose: "サイエンスヒルズ", nps: 8, satisfaction: "満足", source: "Instagram", comment: "駅のすぐ裏でアクセスが良く、雨の日でも子供が楽しめたのが良かった。", improvement: "施設内のレストランメニューが少なく、近隣への案内表示も無かった。" },
                { id: 8, type: "夫婦", purpose: "通過・経由", nps: 4, satisfaction: "やや不満", source: "Web検索", comment: "福岡からの飛行機が到着後、レンタカーを借りるまで少し時間がかかった程度。小松市自体には滞在せず。", improvement: "小松市内を観光しようという動機付けになるような情報が空港に無かった。" },
                { id: 9, type: "友人同士", purpose: "食（寿司・小松うどん）", nps: 9, satisfaction: "とても満足", source: "Instagram", comment: "小松のうどんが美味しいと聞いて寄りました。出汁が美味しくて最高でした！", improvement: "人気店だからか待ち時間が長かった。整理券や周辺の周遊案内があれば良いのに。" },
                { id: 10, type: "一人", purpose: "航空プラザ・撮影", nps: 10, satisfaction: "とても満足", source: "Web検索", comment: "展望デッキからの自衛隊機の撮影が目的。最高のロケーションでした。", improvement: "特になし。ミリタリーファン向けのグッズがもっとあれば買っていた。" },
                { id: 11, type: "家族連れ", purpose: "通過・経由", nps: 7, satisfaction: "満足", source: "旅行サイト", comment: "金沢観光の帰りに空港へ向かう途中で少し時間が余ったので駅前に寄った。綺麗だった。", improvement: "お土産屋さんのラインナップが金沢駅とあまり変わらない気がした。" },
                { id: 12, type: "シニア夫婦", purpose: "苔の里", nps: 9, satisfaction: "とても満足", source: "旅行情報誌", comment: "静かで厳かな雰囲気が非常に良かった。ガイドさんの説明も丁寧で理解が深まりました。", improvement: "駐車場から少し歩くので、足腰の弱い人向けのサポート情報が事前に欲しかった。" },
                { id: 13, type: "カップル", purpose: "温泉（山代）経由", nps: 6, satisfaction: "普通", source: "Instagram", comment: "加賀温泉郷へ行く際に通過した。特筆すべき点はなかったが道は混んでいなかった。", improvement: "道中に『小松に寄っていこう』と思わせるような看板や宣伝を見かけなかった。" },
                { id: 14, type: "家族連れ", purpose: "航空プラザ", nps: 9, satisfaction: "とても満足", source: "Instagram", comment: "シミュレーターが面白くて子供が離れませんでした。親もゆっくり休めるスペースがあって助かりました。", improvement: "休日は混雑するので、シミュレーターの事前予約システムなどがあれば嬉しい。" },
                { id: 15, type: "友人同士", purpose: "九谷焼体験", nps: 8, satisfaction: "満足", source: "友人・知人", comment: "ろくろ体験がとても楽しかった！届くのが楽しみです。", improvement: "体験後の手が洗える場所がもう少し広く、綺麗だと嬉しい。" },
                { id: 16, type: "一人", purpose: "歌舞伎のまち巡り", nps: 7, satisfaction: "満足", source: "Web検索", comment: "曳山交流館などを見学。歴史を感じられて興味深かった。", improvement: "点在しているので、レンタサイクルなどの案内がもっと目立つところにあると便利。" },
                { id: 17, type: "夫婦", purpose: "食（寿司）", nps: 10, satisfaction: "とても満足", source: "旅行サイト", comment: "金沢より小松の方がお寿司が美味しいと聞いて訪問。期待通り、いやそれ以上でした！", improvement: "駅からの交通手段がタクシーしかなく、少し不便だった。" },
                { id: 18, type: "家族連れ", purpose: "通過・経由", nps: 5, satisfaction: "普通", source: "Web検索", comment: "空港から福井の恐竜博物館へ直行。小松インターまでの道はスムーズでした。", improvement: "インターまでの道中にコンビニ以外の気軽な飲食店が見当たらなかった。" },
                { id: 19, type: "シニア夫婦", purpose: "自動車博物館", nps: 8, satisfaction: "満足", source: "テレビ", comment: "昔乗っていた車があって懐かしかった。展示数が凄まじい。", improvement: "館内が広すぎて少し疲れた。休憩用のベンチがもう少し各所にあると助かる。" },
                { id: 20, type: "友人同士", purpose: "SNS映えスポット", nps: 7, satisfaction: "満足", source: "Instagram", comment: "木場潟公園から見る白山が綺麗でたくさん写真を撮りました。", improvement: "カフェなどを併設して、ゆっくり景色を楽しめる場所があればもっと良いのに。" }
            ]
        };

        // --- グラフ用カスタムTooltip ---
        const CustomTooltip = ({ active, payload, label }) => {
            if (active && payload && payload.length) {
                return (
                    <div className="custom-tooltip">
                        <p className="font-bold text-gray-700">{`${label}`}</p>
                        {payload.map((entry, index) => (
                            <p key={index} style={{ color: entry.color || entry.fill }}>
                                {entry.name || '割合/数'}: <span className="font-bold">{entry.value}{entry.name === 'value' ? '%' : '人'}</span>
                            </p>
                        ))}
                    </div>
                );
            }
            return null;
        };

        const COLORS = ['#4FD1C5', '#38B2AC', '#1A759F', '#E85D04', '#F6AD55', '#ED8936'];

        // --- タブコンテンツ: 1. データ可視化 (ダッシュボード) ---
        const TabVisualization = () => (
            <div className="space-y-6">
                <div className="flex flex-col sm:flex-row gap-4 mb-4">
                    <div className="tifo-card flex-1 flex items-center gap-4 bg-gradient-to-r from-teal-50 to-white">
                        <div className="p-3 bg-teal-100 rounded-full text-teal-600"><IconUsers /></div>
                        <div>
                            <p className="text-sm font-bold text-gray-500">回答者総数（福岡県）</p>
                            <p className="text-3xl font-extrabold text-gray-800">{surveyData.overview.totalRespondents}<span className="text-sm font-medium ml-1">件</span></p>
                        </div>
                    </div>
                    <div className="tifo-card flex-1 flex items-center gap-4 bg-gradient-to-r from-orange-50 to-white">
                        <div className="p-3 bg-orange-100 rounded-full text-orange-600"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="m12 14 4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/></svg></div>
                        <div>
                            <p className="text-sm font-bold text-gray-500">平均推奨度 (NPS)</p>
                            <p className="text-3xl font-extrabold text-gray-800">{surveyData.overview.avgNps}<span className="text-sm font-medium ml-1">/ 10</span></p>
                        </div>
                    </div>
                </div>

                <div className="grid grid-cols-1 lg:grid-cols-2 gap-6 print-break-inside-avoid">
                    {/* NPS分布 (棒グラフ) */}
                    <div className="tifo-card h-80">
                        <h3 className="text-md font-bold text-gray-700 mb-4 text-center">推奨度(NPS)の分布</h3>
                        <ResponsiveContainer width="100%" height="100%">
                            <BarChart data={surveyData.charts.npsDistribution} margin={{ top: 10, right: 10, left: -20, bottom: 20 }}>
                                <CartesianGrid strokeDasharray="3 3" vertical={false} stroke="#E2E8F0"/>
                                <XAxis dataKey="score" tick={{fontSize: 12}} axisLine={false} tickLine={false} />
                                <YAxis tick={{fontSize: 12}} axisLine={false} tickLine={false} />
                                <Tooltip cursor={{fill: '#F7FAFC'}} content={<CustomTooltip />} />
                                <Bar dataKey="count" radius={[4, 4, 0, 0]} name="人数">
                                    {surveyData.charts.npsDistribution.map((entry, index) => (
                                        <Cell key={`cell-${index}`} fill={entry.fill} />
                                    ))}
                                </Bar>
                            </BarChart>
                        </ResponsiveContainer>
                    </div>

                    {/* 同行者属性 (ドーナツチャート) */}
                    <div className="tifo-card h-80">
                        <h3 className="text-md font-bold text-gray-700 mb-4 text-center">同行者の属性</h3>
                        <ResponsiveContainer width="100%" height="100%">
                            <PieChart>
                                <Pie 
                                    data={surveyData.charts.companion} 
                                    innerRadius={60} 
                                    outerRadius={90} 
                                    paddingAngle={5} 
                                    dataKey="value"
                                >
                                    {surveyData.charts.companion.map((entry, index) => (
                                        <Cell key={`cell-${index}`} fill={COLORS[index % COLORS.length]} />
                                    ))}
                                </Pie>
                                <Tooltip content={<CustomTooltip />} />
                                <Legend verticalAlign="bottom" height={36} wrapperStyle={{ fontSize: '12px' }}/>
                            </PieChart>
                        </ResponsiveContainer>
                    </div>

                    {/* 参考にした情報源 (横向き棒グラフ) */}
                    <div className="tifo-card h-80 print-break-inside-avoid">
                        <h3 className="text-md font-bold text-gray-700 mb-4 text-center">参考にした情報源 (複数回答)</h3>
                        <ResponsiveContainer width="100%" height="100%">
                            <BarChart data={surveyData.charts.source} layout="vertical" margin={{ top: 5, right: 30, left: 20, bottom: 5 }}>
                                <CartesianGrid strokeDasharray="3 3" horizontal={false} stroke="#E2E8F0"/>
                                <XAxis type="number" hide />
                                <YAxis dataKey="name" type="category" tick={{fontSize: 12}} axisLine={false} tickLine={false} width={80}/>
                                <Tooltip cursor={{fill: '#F7FAFC'}} content={<CustomTooltip />} />
                                <Bar dataKey="value" fill="var(--tifo-primary)" radius={[0, 4, 4, 0]} name="回答割合(%)" barSize={20} />
                            </BarChart>
                        </ResponsiveContainer>
                    </div>


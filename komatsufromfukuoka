                                            <td className="px-4 py-4 text-orange-700 font-medium text-xs align-top bg-orange-50/30 group-hover:bg-orange-50/80 transition-colors leading-relaxed border-l border-gray-50">
                                                {item.improvement}
                                            </td>
                                        </tr>
                                    ))}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            );
        }

        // --- メインアプリケーション ---
        const App = () => {
            const [activeTab, setActiveTab] = useState('visualization');

            const handlePrint = () => {
                window.print();
            };

            return (
                <div className="min-h-screen flex flex-col">
                    {/* ヘッダー */}
                    <header className="bg-white shadow-sm print-w-full border-b border-gray-200 sticky top-0 z-40">
                        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex flex-col sm:flex-row justify-between items-center gap-4">
                            <div>
                                <h1 className="text-2xl font-extrabold tracking-tight" style={{color: 'var(--tifo-text)'}}>
                                    小松市 観光マーケティング戦略レポート
                                </h1>
                                <p className="text-sm font-bold mt-1" style={{color: 'var(--tifo-primary)'}}>
                                    対象市場: 福岡県からの来訪客データ分析
                                </p>
                            </div>
                            <button 
                                onClick={handlePrint}
                                className="tifo-button no-print text-sm shadow-md"
                            >
                                <IconPrinter /> レポート出力
                            </button>
                        </div>
                        
                        {/* タブナビゲーション */}
                        <div className="no-print max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-2">
                            <nav className="flex space-x-2 overflow-x-auto custom-scrollbar" aria-label="Tabs">
                                {[
                                    { id: 'visualization', icon: <IconBarChart />, label: 'データ可視化 (Dashboard)' },
                                    { id: 'strategy', icon: <IconTarget />, label: '課題と議論の論点' },
                                    { id: 'sns', icon: <IconSmartphone />, label: 'SNS発信アイデア' },
                                    { id: 'data', icon: <IconMessage />, label: '自由記述 (生データ全件)' },
                                ].map(tab => (
                                    <button
                                        key={tab.id}
                                        onClick={() => setActiveTab(tab.id)}
                                        className={`
                                            feedback-tab-button flex items-center gap-2 py-3 px-4
                                            ${activeTab === tab.id ? 'active' : ''}
                                        `}
                                    >
                                        {tab.icon}
                                        {tab.label}
                                    </button>
                                ))}
                            </nav>
                        </div>
                    </header>

                    {/* メインコンテンツ */}
                    <main className="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full print-w-full print:p-0">
                        
                        {/* 印刷用タイトル (画面表示時は非表示) */}
                        <div className="hidden print:block mb-6 pb-2 border-b-2" style={{borderColor: 'var(--tifo-primary)'}}>
                            <h2 className="text-2xl font-bold text-gray-800">
                                {activeTab === 'visualization' && 'データ可視化 (Dashboard)'}
                                {activeTab === 'strategy' && '課題とマーケティング論点'}
                                {activeTab === 'sns' && 'SNS発信アイデア'}
                                {activeTab === 'data' && '自由記述 (生データ全件)'}
                            </h2>
                        </div>

                        {/* タブコンテンツの描画 */}
                        <div className="print-w-full transition-all duration-300 ease-in-out">
                            {activeTab === 'visualization' && <TabVisualization />}
                            {activeTab === 'strategy' && <TabStrategy />}
                            {activeTab === 'sns' && <TabSNS />}
                            {activeTab === 'data' && <TabData />}
                        </div>
                    </main>

                    {/* フッター */}
                    <footer className="mt-auto py-8 text-center text-sm font-bold text-gray-400 no-print">
                        <p>こまつDMO 観光マーケティングレポート - For Internal Meeting</p>
                    </footer>
                </div>
            );
        };

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
